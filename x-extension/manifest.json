{
  "manifest_version": 3,
  "name": "Montage Studio — X Publisher",
  "version": "1.0.0",
  "description": "Upload and publish your Montage Studio videos using X's visible composer in your signed-in browser.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:8765/*", "https://x.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Montage Studio X Publisher"},
  "content_scripts": [{"matches": ["https://x.com/*"], "js": ["content.js"], "run_at": "document_idle"}]
}
